{
  "name": "server",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "lint": "oxlint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:migrate": "kysely migrate latest",
    "db:rollback": "kysely migrate rollback --all",
    "db:reset": "kysely migrate rollback --all && kysely migrate latest",
    "db:seed": "kysely migrate rollback --all && kysely migrate latest && kysely seed run"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.0",
    "@workspace/api": "workspace:*",
    "dotenv": "^18.0.9",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "pg-error-codes": "^1.1.0",
    "pg-error-codes-ts": "^1.0.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "kysely-ctl": "^0.22.0",
    "tsx": "^4.23.15"
  }
}
